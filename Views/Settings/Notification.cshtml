@model itam.Models.NotificationSettingsViewModel

@{
    ViewData["Title"] = "Pengaturan Notifikasi Email";
}

<div class="row mt-3">
    <div class="col-md-8 mx-auto">
        <form asp-action="SaveNotification" method="post">
            
            <!-- EMAIL SETTINGS CARD -->
            <div class="card card-info card-outline shadow-sm mb-4">
                <div class="card-header border-0 d-flex justify-content-between align-items-center">
                    <h3 class="card-title font-weight-bold text-info">
                        <i class="fas fa-envelope mr-2"></i> Pengaturan Notifikasi Email
                    </h3>
                    <div class="custom-control custom-switch custom-switch-lg custom-switch-info">
                        <input type="checkbox" class="custom-control-input" id="EmailEnabled" name="EmailEnabled" value="true" @(Model.EmailEnabled ? "checked" : "")>
                        <label class="custom-control-label" for="EmailEnabled">Aktifkan</label>
                    </div>
                </div>
                
                <div class="card-body bg-light" id="EmailSettingsContainer" style="display: @(Model.EmailEnabled ? "block" : "none");">
                    
                    <div class="row">
                        <div class="col-md-8">
                            <div class="form-group">
                                <label asp-for="SmtpServer">SMTP Server</label>
                                <input asp-for="SmtpServer" class="form-control" placeholder="smtp.gmail.com" />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group">
                                <label asp-for="SmtpPort">Port</label>
                                <input asp-for="SmtpPort" type="number" class="form-control" placeholder="587" />
                            </div>
                        </div>
                    </div>
                    
                    <div class="form-group custom-control custom-checkbox">
                        <input type="checkbox" class="custom-control-input" id="UseSsl" name="UseSsl" value="true" @(Model.UseSsl ? "checked" : "")>
                        <label class="custom-control-label" for="UseSsl">Gunakan SSL/TLS</label>
                    </div>
                    
                    <hr />
                    
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label asp-for="SenderName">Nama Pengirim</label>
                                <input asp-for="SenderName" class="form-control" placeholder="IT Asset Management" />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label asp-for="SenderEmail">Email Pengirim</label>
                                <input asp-for="SenderEmail" type="email" class="form-control" placeholder="no-reply@domain.com" />
                            </div>
                        </div>
                    </div>
                    
                    <div class="form-group">
                        <label asp-for="SenderPassword">Password / App Password</label>
                        <input asp-for="SenderPassword" type="password" class="form-control" placeholder="••••••••" />
                        <small class="form-text text-muted">Gunakan App Password jika menggunakan Gmail.</small>
                    </div>

                    <hr />

                    <div class="form-group">
                        <label asp-for="ToEmails">Email Penerima (To)</label>
                        <textarea asp-for="ToEmails" class="form-control" rows="2" placeholder="admin@domain.com, manager@domain.com"></textarea>
                        <small class="form-text text-muted">Pisahkan dengan koma atau titik koma.</small>
                    </div>
                    
                    <div class="form-group">
                        <label asp-for="CcEmails">Email Tembusan (CC) <span class="text-muted font-weight-normal">(Opsional)</span></label>
                        <textarea asp-for="CcEmails" class="form-control" rows="2" placeholder="staff@domain.com"></textarea>
                    </div>

                    <div class="card mt-4 border-info">
                        <div class="card-header bg-info text-white d-flex justify-content-between align-items-center">
                            <h3 class="card-title mb-0"><i class="fas fa-tasks mr-2"></i> Trigger Event Email</h3>
                            <button type="button" class="btn btn-light btn-sm font-weight-bold" data-toggle="modal" data-target="#modalTestEmail">
                                <i class="fas fa-paper-plane text-info mr-1"></i> Uji Coba Kirim Email
                            </button>
                        </div>
                        <div class="card-body">
                            <div class="custom-control custom-checkbox mb-2">
                                <input type="checkbox" class="custom-control-input" id="NotifBarangMasuk" name="NotifBarangMasuk" value="true" @(Model.NotifBarangMasuk ? "checked" : "")>
                                <label class="custom-control-label" for="NotifBarangMasuk">Barang Masuk</label>
                            </div>
                            <div class="custom-control custom-checkbox mb-2">
                                <input type="checkbox" class="custom-control-input" id="NotifBarangKeluar" name="NotifBarangKeluar" value="true" @(Model.NotifBarangKeluar ? "checked" : "")>
                                <label class="custom-control-label" for="NotifBarangKeluar">Barang Keluar</label>
                            </div>
                            <div class="custom-control custom-checkbox mb-2">
                                <input type="checkbox" class="custom-control-input" id="NotifPeminjaman" name="NotifPeminjaman" value="true" @(Model.NotifPeminjaman ? "checked" : "")>
                                <label class="custom-control-label" for="NotifPeminjaman">Peminjaman / Pengembalian</label>
                            </div>
                            <div class="custom-control custom-checkbox">
                                <input type="checkbox" class="custom-control-input" id="NotifPermintaan" name="NotifPermintaan" value="true" @(Model.NotifPermintaan ? "checked" : "")>
                                <label class="custom-control-label" for="NotifPermintaan">Permintaan Barang</label>
                            </div>
                        </div>
                    </div>

                    <!-- EMAIL TEMPLATE EDITOR -->
                    <div class="card mt-4 border-secondary">
                        <div class="card-header bg-secondary text-white d-flex justify-content-between align-items-center" 
                             style="cursor:pointer" data-toggle="collapse" data-target="#templateEditorBody">
                            <h3 class="card-title mb-0">
                                <i class="fas fa-code mr-2"></i> Template HTML Email
                            </h3>
                            <i class="fas fa-chevron-down" id="templateChevron"></i>
                        </div>
                        <div class="collapse" id="templateEditorBody">
                            <div class="card-body">
                                <div class="alert alert-info mb-3">
                                    <i class="fas fa-info-circle mr-1"></i>
                                    <strong>Placeholder yang tersedia:</strong><br>
                                    <code>{Subject}</code> / <code>{Subjek}</code> — Judul / Subjek notifikasi.<br>
                                    <code>{Content}</code> — Isi pesan notifikasi (wajib ada).<br>
                                    <code>{themeColor}</code> — Warna tema otomatis berdasarkan jenis event.<br>
                                    <code>{Date}</code> — Tanggal & waktu pengiriman.
                                </div>
                                
                                <div class="form-group">
                                    <label for="EmailHtmlTemplate">Kode HTML Template</label>
                                    <textarea asp-for="EmailHtmlTemplate" class="form-control" id="EmailHtmlTemplate" 
                                              rows="16" 
                                              style="font-family: 'Consolas', 'Courier New', monospace; font-size: 13px; background-color: #1e1e1e; color: #d4d4d4; border: 1px solid #444; border-radius: 4px; line-height: 1.5; tab-size: 4;"></textarea>
                                </div>

                                <div class="d-flex justify-content-between align-items-center mt-3">
                                    <button type="button" class="btn btn-outline-warning btn-sm" id="btnResetTemplate">
                                        <i class="fas fa-undo mr-1"></i> Reset ke Default
                                    </button>
                                    <button type="button" class="btn btn-outline-info btn-sm" id="btnPreviewTemplate">
                                        <i class="fas fa-eye mr-1"></i> Preview Template
                                    </button>
                                </div>

                                <!-- Preview Area -->
                                <div class="mt-3" id="previewContainer" style="display:none;">
                                    <label class="font-weight-bold"><i class="fas fa-desktop mr-1"></i> Preview:</label>
                                    <div style="border: 1px solid #dee2e6; border-radius: 4px; overflow: hidden; background: #f4f6f9;">
                                        <iframe id="templatePreviewFrame" style="width:100%; height:400px; border:none;"></iframe>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                </div>
            </div>

            <div class="text-right mb-5">
                <button type="submit" class="btn btn-primary btn-lg shadow-sm">
                    <i class="fas fa-save mr-2"></i> Simpan Pengaturan
                </button>
            </div>
            
        </form>
    </div>
</div>

<!-- Modal Uji Coba Kirim Email -->
<div class="modal fade" id="modalTestEmail" tabindex="-1" role="dialog" aria-labelledby="modalTestEmailLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header bg-info text-white">
                <h5 class="modal-title" id="modalTestEmailLabel"><i class="fas fa-paper-plane mr-1"></i> Uji Coba Kirim Email (SMTP Test)</h5>
                <button type="button" class="close text-white" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <p class="text-muted small">Kirim email uji coba untuk memverifikasi apakah konfigurasi SMTP Server, Email Pengirim, dan Password sudah berjalan dengan baik.</p>
                <div class="form-group">
                    <label class="required font-weight-bold">Alamat Email Tujuan Uji Coba</label>
                    <input type="email" id="testTargetEmail" class="form-control" placeholder="admin@domain.com" value="@Model.SenderEmail" />
                </div>
                <div id="testEmailAlert" style="display:none;" class="alert"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Tutup</button>
                <button type="button" class="btn btn-info" id="btnSendTestEmail">
                    <i class="fas fa-paper-plane mr-1"></i> Kirim Email Uji Coba
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <style>
        .custom-switch-lg .custom-control-label::before {
            height: 1.5rem;
            width: 2.75rem;
            border-radius: 2rem;
        }
        .custom-switch-lg .custom-control-label::after {
            width: 1.25rem;
            height: 1.25rem;
            border-radius: 50%;
            top: 0.375rem;
            left: -2.0rem;
        }
        .custom-switch-lg .custom-control-input:checked ~ .custom-control-label::after {
            transform: translateX(1.25rem);
        }
        .custom-switch-lg .custom-control-label {
            padding-left: 1.5rem;
            padding-top: 0.2rem;
            font-weight: 600;
        }
        
        .custom-switch-primary .custom-control-input:checked ~ .custom-control-label::before {
            border-color: #007bff;
            background-color: #007bff;
        }
        
        .custom-switch-info .custom-control-input:checked ~ .custom-control-label::before {
            border-color: #17a2b8;
            background-color: #17a2b8;
        }
    </style>

    <script>
        $(document).ready(function() {
            // Animasi toggle untuk form Telegram
            $('#TelegramEnabled').change(function() {
                if($(this).is(':checked')) {
                    $('#TelegramSettingsContainer').slideDown();
                } else {
                    $('#TelegramSettingsContainer').slideUp();
                }
            });

            // Animasi toggle untuk form Email
            $('#EmailEnabled').change(function() {
                if($(this).is(':checked')) {
                    $('#EmailSettingsContainer').slideDown();
                } else {
                    $('#EmailSettingsContainer').slideUp();
                }
            });

            // Chevron rotate on collapse toggle
            $('#templateEditorBody').on('show.bs.collapse', function () {
                $('#templateChevron').css('transform', 'rotate(180deg)');
            }).on('hide.bs.collapse', function () {
                $('#templateChevron').css('transform', 'rotate(0deg)');
            });

            // Preview template
            $('#btnPreviewTemplate').click(function() {
                var html = $('#EmailHtmlTemplate').val();
                // Replace placeholders with sample data
                html = html.replace(/\{themeColor\}/g, '#007bff');
                html = html.replace(/\{Subject\}/g, 'Contoh Notifikasi Email');
                html = html.replace(/\{Subjek\}/g, 'Contoh Notifikasi Email');
                html = html.replace(/\{Date\}/g, new Date().toLocaleString('id-ID'));
                html = html.replace(/\{Content\}/g, '<p>Halo,<br><br>Berikut adalah contoh notifikasi dari sistem <strong>IT Asset Management</strong>.</p><div class="item-list"><strong>Daftar Barang:</strong><br>- Laptop Dell Latitude 5520 (SN: ABC123)<br>- Monitor LG 24" (SN: DEF456)</div>');
                
                var $container = $('#previewContainer');
                $container.slideDown();
                
                var iframe = document.getElementById('templatePreviewFrame');
                var doc = iframe.contentDocument || iframe.contentWindow.document;
                doc.open();
                doc.write(html);
                doc.close();
            });

            // Reset template to default
            $('#btnResetTemplate').click(function() {
                if (confirm('Apakah Anda yakin ingin mereset template ke default? Perubahan yang belum disimpan akan hilang.')) {
                    var defaultTemplate = @Html.Raw(Json.Serialize(new itam.Models.EmailSetting().EmailHtmlTemplate));
                    $('#EmailHtmlTemplate').val(defaultTemplate);
                    $('#previewContainer').slideUp();
                }
            });

            // Uji Coba Kirim Email
            $('#btnSendTestEmail').click(function() {
                var target = $('#testTargetEmail').val();
                if (!target) {
                    Swal.fire('Peringatan', 'Masukkan alamat email tujuan uji coba!', 'warning');
                    return;
                }
                var $btn = $(this);
                $btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin mr-1"></i> Mengirim...');
                $('#testEmailAlert').hide();

                var token = $('input[name="__RequestVerificationToken"]').val();
                $.post('@Url.Action("TestEmail", "Settings")', { targetEmail: target, __RequestVerificationToken: token }, function(res) {
                    $btn.prop('disabled', false).html('<i class="fas fa-paper-plane mr-1"></i> Kirim Email Uji Coba');
                    if (res.success) {
                        $('#testEmailAlert').removeClass('alert-danger').addClass('alert-success').html('<i class="fas fa-check-circle mr-1"></i> ' + res.message).show();
                    } else {
                        $('#testEmailAlert').removeClass('alert-success').addClass('alert-danger').html('<i class="fas fa-exclamation-triangle mr-1"></i> ' + res.message).show();
                    }
                }).fail(function() {
                    $btn.prop('disabled', false).html('<i class="fas fa-paper-plane mr-1"></i> Kirim Email Uji Coba');
                    $('#testEmailAlert').removeClass('alert-success').addClass('alert-danger').html('<i class="fas fa-exclamation-triangle mr-1"></i> Gagal menghubungi server.').show();
                });
            });
        });
    </script>
}
