@model itam.Models.Peminjaman
@{ ViewData["Title"] = "Tambah Peminjaman"; }
<div class="card card-outline card-purple">
    <div class="card-header"><h3 class="card-title"><i class="fas fa-plus"></i> Tambah Peminjaman</h3></div>
    <form asp-action="CreateMultiple" method="post">@Html.AntiForgeryToken()
        <div class="card-body">
            <div class="row">
                <div class="col-md-3">
                    <div class="form-group">
                        <label>Tanggal Pinjam</label>
                        <input type="date" name="tanggalPinjam" class="form-control" value="@DateTime.Now.ToString("yyyy-MM-dd")" required />
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <label>Jatuh Tempo</label>
                        <input type="date" name="tanggalJatuhTempo" class="form-control" value="@DateTime.Now.AddDays(7).ToString("yyyy-MM-dd")" required />
                        <small class="text-muted">Default: 7 hari</small>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <label>Peminjam</label>
                        <input type="text" name="peminjam" class="form-control" placeholder="Nama peminjam" required />
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <label>Nopeg</label>
                        <input type="text" name="nipNik" class="form-control" placeholder="Opsional" />
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-3">
                    <div class="form-group">
                        <label>Departemen</label>
                        <input type="text" name="departemen" class="form-control" placeholder="Divisi / Unit" />
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <label>No. HP</label>
                        <input type="text" name="noHp" class="form-control" placeholder="08xxxxxxxxxx" />
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label>Keterangan</label>
                        <input type="text" name="keteranganGlobal" class="form-control" placeholder="Keperluan peminjaman" />
                    </div>
                </div>
            </div>

            <hr/>
            <h5><i class="fas fa-list"></i> Pilih Barang & Serial Number</h5>
            <div class="form-group">
                <label>Pilih Barang</label>
                <select id="selectBarang" class="form-control select2" style="width:100%">
                    <option value="">-- Pilih Barang --</option>
                    @if (ViewBag.Barangs != null)
                    {
                        foreach (var b in (IEnumerable<itam.Models.Barang>)ViewBag.Barangs)
                        {
                            <option value="@b.Id" data-stok="@b.Stok">@b.NamaBarang</option>
                        }
                    }
                </select>
            </div>

            <!-- Box for SNs (Hidden by default, shown when SNs exist) -->
            <div id="snContainer" style="display:none;">
                <div class="card card-outline card-info">
                    <div class="card-header py-2">
                        <h3 class="card-title"><i class="fas fa-barcode"></i> Serial Number Tersedia</h3>
                        <div class="card-tools">
                            <input type="text" id="searchSn" class="form-control form-control-sm" placeholder="Cari SN..." style="width: 150px; display: inline-block; margin-right: 10px;" />
                            <button type="button" class="btn btn-xs btn-info" id="btnCheckAll"><i class="fas fa-check-double"></i> Pilih Semua</button>
                            <button type="button" class="btn btn-xs btn-secondary" id="btnUncheckAll"><i class="fas fa-times"></i> Batal Semua</button>
                        </div>
                    </div>
                    <div class="card-body" id="snList" style="max-height:300px; overflow-y:auto;">
                        <!-- SN checkboxes loaded via AJAX -->
                    </div>
                    <div class="card-footer py-2">
                        <span>Terpilih: <strong id="selectedCount">0</strong> unit</span>
                        <button type="button" class="btn btn-danger btn-sm float-right" id="btnAddSelectedSn"><i class="fas fa-plus"></i> Tambahkan ke Daftar</button>
                    </div>
                </div>
            </div>

            <!-- Box for Non-SN Items (Hidden by default, shown when NO SNs exist) -->
            <div id="nonSnContainer" style="display:none;">
                <div class="card card-outline card-info">
                    <div class="card-header py-2">
                        <h3 class="card-title"><i class="fas fa-box"></i> Barang Tanpa Serial Number</h3>
                    </div>
                    <div class="card-body">
                        <p class="text-muted">Barang ini tidak menggunakan Serial Number. Silakan masukkan jumlah yang ingin dipinjam.</p>
                        <div class="form-group mb-0">
                            <label>Jumlah</label>
                            <input type="number" id="inputJumlah" class="form-control" style="width: 150px;" min="1" value="1" />
                            <small class="text-muted">Maksimal stok: <strong id="maxStok"></strong></small>
                        </div>
                    </div>
                    <div class="card-footer py-2">
                        <button type="button" class="btn btn-danger btn-sm float-right" id="btnAddNonSn"><i class="fas fa-plus"></i> Tambahkan ke Daftar</button>
                    </div>
                </div>
            </div>

            <hr/>
            <h5><i class="fas fa-clipboard-list"></i> Daftar Barang Peminjaman</h5>
            <table class="table table-bordered mt-2" id="tableKeluar">
                <thead class="thead-light">
                    <tr><th width="50">No</th><th>Barang</th><th width="300">Serial Number(s)</th><th width="100">Jumlah</th><th width="200">Keterangan</th><th width="50">Aksi</th></tr>
                </thead>
                <tbody>
                    <!-- Rows added via JavaScript -->
                </tbody>
            </table>
            <div class="text-muted" id="emptyMsg"><i class="fas fa-info-circle"></i> Belum ada barang. Pilih barang dan klik "Tambahkan ke Daftar".</div>
        </div>
        <div class="card-footer">
            <button type="submit" class="btn btn-primary" id="btnSubmit" disabled><i class="fas fa-save"></i> Simpan Peminjaman</button>
            <a href="@Url.Action("Index")" class="btn btn-secondary"><i class="fas fa-arrow-left"></i> Kembali</a>
        </div>
    </form>
</div>

@section Scripts {
<script>
$(function(){
    $('.select2').select2({ theme:'bootstrap4', placeholder:'-- Pilih Barang --', allowClear:true });

    // Load SNs when barang selected
    $('#selectBarang').on('change', function(){
        var barangId = $(this).val();
        var stok = $(this).find('option:selected').data('stok');
        
        if (!barangId) { 
            $('#snContainer').hide(); 
            $('#nonSnContainer').hide();
            return; 
        }
        
        $.getJSON('@Url.Action("GetAvailableSerials", "Peminjaman")' + '?barangId=' + barangId, function(data){
            if (data && data.length > 0) {
                // Has SNs
                var html = '';
                var unitNo = 0;
                data.forEach(function(item){
                    var label = item.sn === '-' ? 'Unit ' + (++unitNo) : item.sn;
                    html += '<div class="custom-control custom-checkbox d-inline-block mr-3 mb-2">'
                        + '<input type="checkbox" class="custom-control-input sn-check" id="sn_'+item.id+'" data-sn-id="'+item.id+'" data-sn="'+label+'">'
                        + '<label class="custom-control-label" for="sn_'+item.id+'">'+label+'</label></div>';
                });
                $('#snList').html(html);
                $('#snContainer').show();
                $('#nonSnContainer').hide();
                updateCount();
            } else {
                // No SNs
                $('#snContainer').hide();
                $('#nonSnContainer').show();
                $('#inputJumlah').attr('max', stok).val(1);
                $('#maxStok').text(stok);
            }
        });
    });

    // Check/Uncheck all
    $('#btnCheckAll').click(function(){ $('.sn-check').prop('checked', true); updateCount(); });
    $('#btnUncheckAll').click(function(){ $('.sn-check').prop('checked', false); updateCount(); });
    $(document).on('change', '.sn-check', function(){ updateCount(); });

    $('#searchSn').on('keyup', function(){
        var val = $(this).val().toLowerCase();
        $('#snList .custom-checkbox').filter(function(){
            $(this).toggle($(this).text().toLowerCase().indexOf(val) > -1);
        });
    });

    function updateCount(){ $('#selectedCount').text($('.sn-check:checked').length); }

    // Add selected SNs to table
    $('#btnAddSelectedSn').click(function(){
        var barangId = $('#selectBarang').val();
        var barangName = $('#selectBarang option:selected').text();
        var checked = $('.sn-check:checked');
        if (checked.length === 0) { Swal.fire('Peringatan', 'Pilih minimal 1 SN!', 'warning'); return; }

        var snNames = [];
        var snIds = [];
        checked.each(function(){
            snIds.push($(this).data('sn-id'));
            snNames.push($(this).data('sn'));
        });

        var n = $('#tableKeluar tbody tr').length; // 0-indexed for snRows!
        var row = '<tr>'
            + '<td class="row-num">' + (n+1) + '</td>'
            + '<td>' + barangName + '<input type="hidden" name="barangIds" value="' + barangId + '"></td>'
            + '<td><small>' + snNames.join(', ') + '</small>';
        snIds.forEach(function(id){ row += '<input type="hidden" name="snRows[' + n + '][]" value="' + id + '">'; });
        row += '</td>'
            + '<td><input type="number" name="jumlahs" class="form-control form-control-sm" value="' + checked.length + '" readonly></td>'
            + '<td><input type="text" name="keterangans" class="form-control form-control-sm" placeholder="Opsional" /></td>'
            + '<td><button type="button" class="btn btn-danger btn-xs remove-row-k"><i class="fas fa-times"></i></button></td>'
            + '</tr>';

        $('#tableKeluar tbody').append(row);
        $('#emptyMsg').hide();

        // Reset selection
        $('#selectBarang').val('').trigger('change');
        $('#snContainer').hide();
        renumberKeluar();
        updateSubmit();
    });

    // Add Non-SN item to table
    $('#btnAddNonSn').click(function(){
        var barangId = $('#selectBarang').val();
        var barangName = $('#selectBarang option:selected').text();
        var jml = parseInt($('#inputJumlah').val());
        var max = parseInt($('#inputJumlah').attr('max'));
        
        if (isNaN(jml) || jml < 1) { Swal.fire('Peringatan', 'Jumlah tidak valid!', 'warning'); return; }
        if (jml > max) { Swal.fire('Peringatan', 'Jumlah melebihi stok yang tersedia!', 'warning'); return; }

        var n = $('#tableKeluar tbody tr').length;
        var row = '<tr>'
            + '<td class="row-num">' + (n+1) + '</td>'
            + '<td>' + barangName + '<input type="hidden" name="barangIds" value="' + barangId + '"></td>'
            + '<td><span class="text-muted">Tidak ada SN</span></td>'
            + '<td><input type="number" name="jumlahs" class="form-control form-control-sm" value="' + jml + '" readonly></td>'
            + '<td><input type="text" name="keterangans" class="form-control form-control-sm" placeholder="Opsional" /></td>'
            + '<td><button type="button" class="btn btn-danger btn-xs remove-row-k"><i class="fas fa-times"></i></button></td>'
            + '</tr>';

        $('#tableKeluar tbody').append(row);
        $('#emptyMsg').hide();

        // Reset selection
        $('#selectBarang').val('').trigger('change');
        $('#nonSnContainer').hide();
        renumberKeluar();
        updateSubmit();
    });

    $(document).on('click','.remove-row-k',function(){
        $(this).closest('tr').remove();
        renumberKeluar();
        if ($('#tableKeluar tbody tr').length === 0) $('#emptyMsg').show();
        updateSubmit();
    });

    function renumberKeluar(){ 
        $('#tableKeluar tbody tr').each(function(i){ 
            $(this).find('.row-num').text(i+1); 
            // Also renumber the snRows[X][] inputs to match the row index!
            $(this).find('input[name^="snRows["]').each(function() {
                var currentName = $(this).attr('name');
                var newName = currentName.replace(/snRows\[\d+\]/, 'snRows[' + i + ']');
                $(this).attr('name', newName);
            });
        }); 
    }

    function updateSubmit(){
        $('#btnSubmit').prop('disabled', $('#tableKeluar tbody tr').length === 0);
    }

    // Initial state
    updateSubmit();
});
</script>
}
