@model itam.Models.Barang
@{
    ViewData["Title"] = "Detail Histori Barang";
    var historiMasuk = ViewBag.HistoriMasuk as IEnumerable<itam.Models.BarangMasuk> ?? new List<itam.Models.BarangMasuk>();
    var historiKeluar = ViewBag.HistoriKeluar as IEnumerable<itam.Models.BarangKeluar> ?? new List<itam.Models.BarangKeluar>();

    var combinedMasuk = historiMasuk.Select(m => new { Tanggal = m.TanggalMasuk, Jumlah = m.Jumlah, Lokasi = m.Lokasi?.NamaLokasi, Keterangan = m.Keterangan, Jenis = "Baru" })
        .OrderByDescending(x => x.Tanggal).ToList();
}

<div class="row">
    <div class="col-md-4">
        <div class="card card-outline card-info">
            <div class="card-header">
                <h3 class="card-title">Informasi Barang</h3>
            </div>
            <div class="card-body box-profile">
                @if (!string.IsNullOrEmpty(Model.Gambar))
                {
                    <div class="text-center mb-3">
                        <img class="profile-user-img img-fluid img-circle" src="@Model.Gambar" alt="Gambar Barang" style="width: 150px; height: 150px; object-fit: cover;">
                    </div>
                }
                <h3 class="profile-username text-center">@Model.NamaBarang</h3>
                <p class="text-muted text-center">Kode: @Model.KodeBarang</p>


                <ul class="list-group list-group-unbordered mb-3">
                    <li class="list-group-item">
                        <b>Kategori</b> <a class="float-right">@(Model.Kategori?.NamaKategori ?? "-")</a>
                    </li>
                    <li class="list-group-item">
                        <b>Satuan</b> <a class="float-right">@Model.Satuan</a>
                    </li>
                    <li class="list-group-item">
                        <b>Total Stok Saat Ini</b>
                        <span class="badge bg-primary float-right" style="font-size: 1.1em;">@Model.Stok</span>
                    </li>
                    @{
                        var snListCount = (ViewBag.SnTersedia as IEnumerable<itam.Models.BarangSerial>)?.Count() ?? 0;
                    }
                    <li class="list-group-item">
                        <b>Unit SN Tersedia</b>
                        <span class="badge @(snListCount == Model.Stok ? "bg-success" : "bg-warning text-dark") float-right" style="font-size: 1.1em;">@snListCount</span>
                    </li>
                </ul>

                @if (User.IsInRole("SuperAdmin") || User.IsInRole("AdminGudang"))
                {
                    <form asp-action="SyncStok" asp-route-id="@Model.Id" method="post" class="mb-2" onsubmit="return confirm('Sinkronkan stok & status SN barang ini dengan riwayat transaksi?');">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-outline-primary btn-block shadow-sm">
                            <i class="fas fa-sync-alt"></i> <b>Sinkronkan Stok & SN</b>
                        </button>
                    </form>
                }

                <a href="@Url.Action("Index")" class="btn btn-secondary btn-block"><b>Kembali</b></a>
            </div>
        </div>

        <!-- Daftar S/N Tersedia -->
        <div class="card card-outline card-info mt-3">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h3 class="card-title text-info mb-0"><i class="fas fa-barcode"></i> Unit S/N Tersedia (@snListCount)</h3>
            </div>
            <div class="card-body p-0">
                @{
                    var snList = ViewBag.SnTersedia as IEnumerable<itam.Models.BarangSerial>;
                    var hasRealSn = snList != null && snList.Any(s => s.SerialNumber != "-");
                    if (snList != null && snList.Any())
                    {
                        if (hasRealSn)
                        {
                            <div style="max-height: 250px; overflow-y: auto;">
                                <table class="table table-sm table-striped m-0">
                                    <thead>
                                        <tr>
                                            <th>S/N</th>
                                            <th>Kondisi</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var sn in snList)
                                        {
                                            var badgeClass = sn.Kondisi == "Baru" ? "badge-success" : "badge-warning text-dark";
                                            <tr>
                                                <td><small>@(sn.SerialNumber == "-" ? "(Non-SN)" : sn.SerialNumber)</small></td>
                                                <td><span class="badge @badgeClass">@sn.Kondisi</span></td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <div class="p-3 text-center text-muted">
                                <i class="fas fa-boxes text-info fa-2x mb-2"></i><br/>
                                <strong>Barang Non-Serial Number</strong><br/>
                                <small>Pelacakan stok berbasis kuantitas total (Tersedia: <b>@Model.Stok @Model.Satuan</b>)</small>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="p-3 text-center text-muted">Belum ada S/N atau stok kosong</div>
                    }
                }
            </div>
        </div>
        
    </div>

    <div class="col-md-8">
        <!-- Riwayat Masuk Terbaru -->
        <div class="card card-outline card-success shadow-sm">
            <div class="card-header">
                <h3 class="card-title"><i class="fas fa-arrow-down text-success"></i> Riwayat Masuk Terbaru</h3>
            </div>
            <div class="card-body p-0">
                <table class="table table-striped table-hover m-0">
                    <thead>
                        <tr>
                            <th>Tanggal</th>
                            <th>Status / Jenis</th>
                            <th>Jumlah</th>
                            <th>Ruangan</th>
                            <th>Keterangan</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            if (combinedMasuk.Any())
                            {
                                foreach (var item in combinedMasuk.Take(10))
                                {
                                    <tr>
                                        <td>@item.Tanggal.ToString("dd MMM yyyy")</td>
                                        <td><span class="badge bg-primary">Barang Masuk</span></td>
                                        <td><span class="badge bg-success">+@item.Jumlah</span></td>
                                        <td>@(item.Lokasi ?? "Gudang Utama")</td>
                                        <td>@item.Keterangan</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr><td colspan="5" class="text-center text-muted">Belum ada riwayat masuk</td></tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="card card-outline card-danger shadow-sm mt-4">
            <div class="card-header">
                <h3 class="card-title"><i class="fas fa-arrow-up text-danger"></i> Riwayat Keluar Terbaru</h3>
            </div>
            <div class="card-body p-0">
                <table class="table table-striped table-hover m-0">
                    <thead>
                        <tr>
                            <th>Tanggal</th>
                            <th>Jumlah</th>
                            <th>Ruangan</th>
                            <th>Keterangan / Penerima</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            if (historiKeluar.Any())
                            {
                                foreach (var item in historiKeluar.Take(10))
                                {
                                    <tr>
                                        <td>@item.TanggalKeluar.ToString("dd MMM yyyy")</td>
                                        <td><span class="badge bg-danger">-@item.Jumlah</span></td>
                                        <td>@(item.Lokasi?.NamaLokasi ?? "Gudang Utama")</td>
                                        <td>@item.Penerima</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr><td colspan="4" class="text-center text-muted">Belum ada riwayat keluar</td></tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
