@{
    ViewData["Title"] = "Dashboard";
    var charts = (List<itam.Models.ChartSetting>)ViewBag.Charts;
    var isStaffOrAdmin = User.IsInRole("SuperAdmin") || User.IsInRole("AdminGudang") || User.IsInRole("Supervisor");
    var userRecentReqs = (List<itam.Models.Permintaan>?)ViewBag.UserRecentPermintaans ?? new List<itam.Models.Permintaan>();
}

@if (!isStaffOrAdmin)
{
    <div class="row">
        <div class="col-lg-3 col-6">
            <div class="small-box bg-warning">
                <div class="inner">
                    <h3>@ViewBag.UserPermintaanPending</h3>
                    <p>Permintaan Pending</p>
                </div>
                <div class="icon"><i class="fas fa-clock"></i></div>
                <a href="@Url.Action("Index","Permintaan", new { status = "Menunggu Approval" })" class="small-box-footer">Lihat Status <i class="fas fa-arrow-circle-right"></i></a>
            </div>
        </div>
        <div class="col-lg-3 col-6">
            <div class="small-box bg-success">
                <div class="inner">
                    <h3>@ViewBag.UserPermintaanDisetujui</h3>
                    <p>Permintaan Disetujui</p>
                </div>
                <div class="icon"><i class="fas fa-check-circle"></i></div>
                <a href="@Url.Action("Index","Permintaan", new { status = "Disetujui" })" class="small-box-footer">Lihat Detail <i class="fas fa-arrow-circle-right"></i></a>
            </div>
        </div>
        <div class="col-lg-3 col-6">
            <div class="small-box bg-danger">
                <div class="inner">
                    <h3>@ViewBag.UserPermintaanDitolak</h3>
                    <p>Permintaan Ditolak</p>
                </div>
                <div class="icon"><i class="fas fa-times-circle"></i></div>
                <a href="@Url.Action("Index","Permintaan", new { status = "Ditolak" })" class="small-box-footer">Lihat Detail <i class="fas fa-arrow-circle-right"></i></a>
            </div>
        </div>
        <div class="col-lg-3 col-6">
            <div class="small-box bg-primary">
                <div class="inner">
                    <h3><i class="fas fa-plus-circle"></i></h3>
                    <p>Buat Permintaan Baru</p>
                </div>
                <div class="icon"><i class="fas fa-paper-plane"></i></div>
                <a href="@Url.Action("Create","Permintaan")" class="small-box-footer">Form Pengajuan <i class="fas fa-arrow-circle-right"></i></a>
            </div>
        </div>
    </div>

    @if (userRecentReqs.Any())
    {
        <div class="card card-outline card-primary">
            <div class="card-header d-flex align-items-center justify-content-between">
                <h3 class="card-title mb-0"><i class="fas fa-clipboard-list text-primary mr-1"></i> Permintaan Barang Saya Terbaru</h3>
                <div class="card-tools ml-auto">
                    <a href="@Url.Action("Index", "Permintaan")" class="btn btn-primary btn-xs">Lihat Semua Permintaan Saya</a>
                </div>
            </div>
            <div class="card-body p-0">
                <table class="table table-striped table-sm">
                    <thead>
                        <tr>
                            <th>No. Request</th>
                            <th>Jenis</th>
                            <th>Penerima</th>
                            <th>Barang Diminta</th>
                            <th>Tanggal</th>
                            <th>Status</th>
                            <th width="120">Aksi</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in userRecentReqs)
                        {
                            var itemSummary = string.Join(", ", item.Details.Select(d => $"{d.Barang?.NamaBarang} ({d.Jumlah})"));
                            var statusBadge = item.Status switch
                            {
                                "Disetujui" => "badge-success",
                                "Ditolak" => "badge-danger",
                                "Dibatalkan" => "badge-secondary",
                                _ => "badge-warning"
                            };

                            <tr>
                                <td><span class="badge bg-secondary font-monospace">@item.NoPermintaan</span></td>
                                <td><span class="badge @(item.JenisPermintaan == "Peminjaman" ? "badge-info" : "badge-primary")">@(item.JenisPermintaan == "Peminjaman" ? "Peminjaman" : "Barang Keluar")</span></td>
                                <td><strong>@item.Penerima</strong></td>
                                <td>@itemSummary</td>
                                <td>@item.TanggalPengajuan.ToString("dd/MM/yyyy HH:mm")</td>
                                <td><span class="badge @statusBadge">@item.Status</span></td>
                                <td>
                                    <a href="@Url.Action("Detail", "Permintaan", new { id = item.Id })" class="btn btn-info btn-xs">
                                        <i class="fas fa-eye"></i> Detail
                                    </a>
                                    <a href="@Url.Action("SuratPermintaan", "Permintaan", new { id = item.Id })" class="btn btn-secondary btn-xs">
                                        <i class="fas fa-print"></i> Form
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
}
else
{
<div class="row">
    <div class="col-lg col-md-4 col-6">
        <div class="small-box bg-info">
            <div class="inner">
                <h3>@ViewBag.TotalBarang</h3>
                <p>Total Barang</p>
            </div>
            <div class="icon"><i class="fas fa-boxes"></i></div>
            <a href="@Url.Action("Index","Barang")" class="small-box-footer">Lihat Detail <i class="fas fa-arrow-circle-right"></i></a>
        </div>
    </div>
    <div class="col-lg col-md-4 col-6">
        <div class="small-box bg-gradient-teal">
            <div class="inner">
                <h3>@ViewBag.TotalBarangMasuk</h3>
                <p>Barang Masuk</p>
            </div>
            <div class="icon"><i class="fas fa-arrow-down"></i></div>
            <a href="@Url.Action("Index","BarangMasuk")" class="small-box-footer">Lihat Detail <i class="fas fa-arrow-circle-right"></i></a>
        </div>
    </div>
    <div class="col-lg col-md-4 col-6">
        <div class="small-box bg-gradient-orange">
            <div class="inner">
                <h3>@ViewBag.TotalBarangKeluar</h3>
                <p>Barang Keluar</p>
            </div>
            <div class="icon"><i class="fas fa-arrow-up"></i></div>
            <a href="@Url.Action("Index","BarangKeluar")" class="small-box-footer">Lihat Detail <i class="fas fa-arrow-circle-right"></i></a>
        </div>
    </div>
    <div class="col-lg col-md-4 col-6">
        <div class="small-box bg-warning">
            <div class="inner">
                <h3>@ViewBag.PendingPermintaanCount</h3>
                <p>Permintaan Pending</p>
            </div>
            <div class="icon"><i class="fas fa-clipboard-check"></i></div>
            <a href="@Url.Action("Index","Permintaan", new { status = "Menunggu Approval" })" class="small-box-footer">Lihat Detail <i class="fas fa-arrow-circle-right"></i></a>
        </div>
    </div>
    <div class="col-lg col-md-4 col-6">
        <div class="small-box bg-danger">
            <div class="inner">
                <h3>@ViewBag.StokRendah</h3>
                <p>Stok Rendah</p>
            </div>
            <div class="icon"><i class="fas fa-exclamation-triangle"></i></div>
            <a href="@Url.Action("Index","Stok")" class="small-box-footer">Lihat Detail <i class="fas fa-arrow-circle-right"></i></a>
        </div>
    </div>
</div>
}

@if (charts.Any())
{
    <div class="row">
        @foreach (var chart in charts)
        {
            <div class="col-md-@chart.Lebar">
                <div class="card card-outline card-primary">
                    <div class="card-header">
                        <h3 class="card-title"><i class="fas fa-chart-bar"></i> @chart.NamaChart</h3>
                    </div>
                    <div class="card-body">
                        <canvas id="chart_@chart.Id" height="@(chart.Lebar >= 8 ? 100 : 200)"></canvas>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="alert alert-warning">
        <i class="fas fa-info-circle"></i> Belum ada chart yang dikonfigurasi. <a href="@Url.Action("Index","ChartSetting")">Setting Chart & Grafik</a> untuk menambahkan chart ke dashboard.
    </div>
}

@if (((List<itam.Models.Barang>)ViewBag.LowStockItems).Any())
{
    <div class="card card-outline card-danger">
        <div class="card-header">
            <h3 class="card-title"><i class="fas fa-exclamation-triangle text-danger"></i> Barang Stok Rendah</h3>
        </div>
        <div class="card-body p-0">
            <table class="table table-striped table-sm">
                <thead>
                    <tr>
                        <th>Kode</th>
                        <th>Nama Barang</th>
                        <th>Kategori</th>
                        <th>Kategori</th>
                        <th>Stok</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in (List<itam.Models.Barang>)ViewBag.LowStockItems)
                    {
                        <tr>
                            <td>@item.KodeBarang</td>
                            <td>@item.NamaBarang</td>

                            <td>@item.Kategori?.NamaKategori</td>
                            <td><strong>@item.Stok</strong></td>
                            <td>
                                @if (item.Stok == 0)
                                {
                                    <span class="badge badge-stok-habis">Habis</span>
                                }
                                else
                                {
                                    <span class="badge badge-stok-rendah">Rendah</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@{ var pendingReqs = (List<itam.Models.Permintaan>?)ViewBag.PendingPermintaanItems ?? new List<itam.Models.Permintaan>(); }
@if (pendingReqs.Any() && (User.IsInRole("SuperAdmin") || User.IsInRole("AdminGudang")))
{
    <div class="card card-outline card-warning">
        <div class="card-header d-flex align-items-center justify-content-between">
            <h3 class="card-title mb-0"><i class="fas fa-bell text-warning mr-1"></i> Permintaan Menunggu Persetujuan Admin (@ViewBag.PendingPermintaanCount)</h3>
            <div class="card-tools ml-auto">
                <a href="@Url.Action("Index", "Permintaan", new { status = "Menunggu Approval" })" class="btn btn-warning btn-xs">Lihat Semua</a>
            </div>
        </div>
        <div class="card-body p-0">
            <table class="table table-striped table-sm">
                <thead>
                    <tr>
                        <th>No. Request</th>
                        <th>Jenis</th>
                        <th>Pemohon</th>
                        <th>Penerima</th>
                        <th>Barang Diminta</th>
                        <th>Tanggal</th>
                        <th width="80">Aksi</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in pendingReqs)
                    {
                        var itemSummary = string.Join(", ", item.Details.Select(d => $"{d.Barang?.NamaBarang} ({d.Jumlah})"));
                        <tr class="table-warning">
                            <td><span class="badge bg-secondary">@item.NoPermintaan</span></td>
                            <td><span class="badge @(item.JenisPermintaan == "Peminjaman" ? "badge-info" : "badge-primary")">@(item.JenisPermintaan == "Peminjaman" ? "Peminjaman" : "Barang Keluar")</span></td>
                            <td>@item.PemohonUser</td>
                            <td><strong>@item.Penerima</strong></td>
                            <td>@itemSummary</td>
                            <td>@item.TanggalPengajuan.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>
                                <a href="@Url.Action("Detail", "Permintaan", new { id = item.Id })" class="btn btn-primary btn-xs">
                                    <i class="fas fa-check-circle"></i> Review
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
@{ var overdueCount = (int)(ViewBag.OverduePeminjaman ?? 0); }
@if (overdueCount > 0)
{
    <div class="card card-outline card-warning">
        <div class="card-header">
            <h3 class="card-title"><i class="fas fa-clock text-warning"></i> Peminjaman Jatuh Tempo (@overdueCount)</h3>
        </div>
        <div class="card-body p-0">
            <table class="table table-striped table-sm">
                <thead><tr><th>No Peminjaman</th><th>Barang</th><th>Peminjam</th><th>Jatuh Tempo</th><th>Terlambat</th></tr></thead>
                <tbody>
                    @foreach (var p in (List<itam.Models.Peminjaman>)ViewBag.OverdueItems)
                    {
                        var days = (DateTime.Now - p.TanggalJatuhTempo).Days;
                        <tr class="table-warning">
                            <td>@p.NoPeminjaman</td>
                            <td>@p.Barang?.NamaBarang</td>

                            <td>@p.Peminjam</td>
                            <td>@p.TanggalJatuhTempo.ToString("dd/MM/yyyy")</td>
                            <td><span class="badge badge-danger">@days hari</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@section Scripts {
    <script>
        fetch('@Url.Action("GetChartData", "Dashboard")')
            .then(r => r.json())
            .then(data => {
                const defaultColors = ['#007bff','#28a745','#ffc107','#dc3545','#17a2b8','#6f42c1','#fd7e14','#20c997','#e83e8c','#6c757d'];

                @foreach (var chart in charts)
                {
                    <text>
                    (function() {
                        var ctx = document.getElementById('chart_@chart.Id');
                        if (!ctx) return;
                        var chartType = '@chart.TipeChart';
                        var isHorizontal = false;
                        if (chartType === 'bar-horizontal') {
                            chartType = 'bar';
                            isHorizontal = true;
                        }

                        var sumber = '@chart.SumberData';
                        var color1 = '@chart.WarnaUtama' || '#007bff';
                        var color2 = '@chart.WarnaKedua' || '#dc3545';
                        var config = { type: chartType, options: { responsive: true } };
                        if (isHorizontal) {
                            config.options.indexAxis = 'y';
                        }

                        if (sumber === 'masuk_keluar') {
                            config.data = {
                                labels: data.labels,
                                datasets: [
                                    { label: 'Barang Masuk', data: data.masuk, backgroundColor: color1 + 'B3', borderColor: color1, borderWidth: 1 },
                                    { label: 'Barang Keluar', data: data.keluar, backgroundColor: color2 + 'B3', borderColor: color2, borderWidth: 1 }
                                ]
                            };
                            if (chartType === 'bar' || chartType === 'line') {
                                config.options.scales = isHorizontal ? { x: { beginAtZero: true } } : { y: { beginAtZero: true } };
                            }
                        } else if (sumber === 'per_kategori') {
                            config.data = {
                                labels: data.kategoriLabels,
                                datasets: [{ data: data.kategoriCounts, backgroundColor: defaultColors.slice(0, data.kategoriLabels.length) }]
                            };
                            config.options.plugins = { legend: { position: 'bottom' } };
                        } else if (sumber === 'stok_barang') {
                            config.data = {
                                labels: data.stokLabels,
                                datasets: [{ label: 'Stok Terbanyak', data: data.stokValues, backgroundColor: color1 + 'B3', borderColor: color1, borderWidth: 1 }]
                            };
                            if (chartType === 'bar' || chartType === 'line') {
                                config.options.scales = isHorizontal ? { x: { beginAtZero: true } } : { y: { beginAtZero: true } };
                            }
                        } else if (sumber === 'top_keluar') {
                            config.data = {
                                labels: data.topKeluarLabels,
                                datasets: [{ label: 'Total Barang Keluar', data: data.topKeluarValues, backgroundColor: color2 + 'B3', borderColor: color2, borderWidth: 1 }]
                            };
                            if (chartType === 'bar' || chartType === 'line') {
                                config.options.scales = isHorizontal ? { x: { beginAtZero: true } } : { y: { beginAtZero: true } };
                            }
                        }
                        new Chart(ctx, config);
                    })();
                    </text>
                }
            });
    </script>
}
