@model IEnumerable<itam.Models.Permintaan>
@{
    ViewData["Title"] = "Permintaan Barang";
    var isStaffOrAdmin = User.IsInRole("SuperAdmin") || User.IsInRole("AdminGudang");
    var currentStatus = ViewBag.CurrentStatus as string ?? "";
    var pendingCount = (int)(ViewBag.PendingCount ?? 0);
}

<div class="card card-outline card-primary">
    <div class="card-header d-flex align-items-center justify-content-between">
        <h3 class="card-title mb-0"><i class="fas fa-clipboard-list text-primary mr-1"></i> Permintaan Barang & Peminjaman</h3>
        <div class="card-tools ml-auto">
            <a href="@Url.Action("ExportExcel", new { status = currentStatus })" class="btn btn-outline-success btn-sm mr-1"><i class="fas fa-file-excel mr-1"></i> Export Excel</a>
            <a href="@Url.Action("Create")" class="btn btn-success btn-sm"><i class="fas fa-plus mr-1"></i> Buat Permintaan Baru</a>
        </div>
    </div>
    <div class="card-body">
        <div class="mb-3 d-flex flex-wrap align-items-center gap-2">
            <div class="btn-group flex-wrap" role="group">
                <a href="@Url.Action("Index")" class="btn btn-outline-secondary btn-sm @(string.IsNullOrEmpty(currentStatus) ? "active" : "")">
                    Semua
                </a>
                <a href="@Url.Action("Index", new { status = "Menunggu Approval" })" class="btn btn-outline-warning btn-sm @(currentStatus == "Menunggu Approval" ? "active" : "")">
                    Menunggu Approval @if (pendingCount > 0) { <span class="badge badge-danger">@pendingCount</span> }
                </a>
                <a href="@Url.Action("Index", new { status = "Dipakai Operasional" })" class="btn btn-outline-primary btn-sm @(currentStatus == "Dipakai Operasional" ? "active" : "")">
                    Dipakai Operasional
                </a>
                <a href="@Url.Action("Index", new { status = "Menunggu Persetujuan Pengembalian" })" class="btn btn-outline-warning btn-sm @(currentStatus == "Menunggu Persetujuan Pengembalian" ? "active" : "")">
                    Menunggu Return
                </a>
                <a href="@Url.Action("Index", new { status = "Dikembalikan" })" class="btn btn-outline-info btn-sm @(currentStatus == "Dikembalikan" ? "active" : "")">
                    Dikembalikan
                </a>
                <a href="@Url.Action("Index", new { status = "Disetujui" })" class="btn btn-outline-success btn-sm @(currentStatus == "Disetujui" ? "active" : "")">
                    Disetujui
                </a>
                <a href="@Url.Action("Index", new { status = "Ditolak" })" class="btn btn-outline-danger btn-sm @(currentStatus == "Ditolak" ? "active" : "")">
                    Ditolak
                </a>
                <a href="@Url.Action("Index", new { status = "Dibatalkan" })" class="btn btn-outline-dark btn-sm @(currentStatus == "Dibatalkan" ? "active" : "")">
                    Dibatalkan
                </a>
            </div>
        </div>

        <table class="table table-bordered table-hover data-table">
            <thead class="thead-light">
                <tr>
                    <th width="30">No</th>
                    <th>No. Permintaan</th>
                    <th>Jenis</th>
                    <th>Pemohon</th>
                    <th>Penerima</th>
                    <th>Ruangan</th>
                    <th>Barang Diminta</th>
                    <th>Tgl Pengajuan</th>
                    <th>Status</th>
                    <th width="120">Aksi</th>
                </tr>
            </thead>
            <tbody>
                @{ int no = 1; }
                @foreach (var item in Model)
                {
                    var statusBadge = item.Status switch
                    {
                        "Disetujui" => "badge-success",
                        "Dipakai Operasional" => "badge-primary",
                        "Menunggu Persetujuan Pengembalian" => "badge-warning text-dark",
                        "Dikembalikan" => "badge-info",
                        "Ditolak" => "badge-danger",
                        "Dibatalkan" => "badge-secondary",
                        _ => "badge-warning"
                    };

                    var jenisBadge = item.JenisPermintaan switch
                    {
                        "Peminjaman" => "badge-info",
                        "BarangOperasional" => "badge-warning text-dark",
                        _ => "badge-primary"
                    };

                    var jenisText = item.JenisPermintaan switch
                    {
                        "Peminjaman" => "Peminjaman",
                        "BarangOperasional" => "Barang Operasional",
                        _ => "Barang Keluar"
                    };

                    var totalItemCount = item.Details.Sum(d => d.Jumlah);
                    var itemSummary = item.Details.Select(d => $"{d.Barang?.NamaBarang} ({d.Jumlah})").ToList();
                    var displaySummary = string.Join(", ", itemSummary.Take(2));
                    if (itemSummary.Count > 2) displaySummary += $" (+{itemSummary.Count - 2} lainnya)";

                    <tr>
                        <td>@(no++)</td>
                        <td><span class="badge bg-secondary font-monospace">@item.NoPermintaan</span></td>
                        <td><span class="badge @jenisBadge">@jenisText</span></td>
                        <td>@item.PemohonUser</td>
                        <td>
                            <strong>@item.Penerima</strong>
                            @if (!string.IsNullOrEmpty(item.Departemen))
                            {
                                <br /><small class="text-muted">@item.Departemen</small>
                            }
                        </td>
                        <td>@(item.Lokasi?.NamaLokasi ?? "-")</td>
                        <td>
                            @displaySummary
                            <br /><small class="text-muted">Total: @totalItemCount unit</small>
                        </td>
                        <td>@item.TanggalPengajuan.ToString("dd/MM/yyyy HH:mm")</td>
                        <td><span class="badge @statusBadge">@item.Status</span></td>
                        <td>
                            <a href="@Url.Action("Detail", new { id = item.Id })" class="btn btn-info btn-xs" title="Lihat Detail">
                                <i class="fas fa-eye"></i> Detail
                            </a>
                            <a href="@Url.Action("SuratPermintaan", new { id = item.Id })" class="btn btn-secondary btn-xs" title="Cetak Form">
                                <i class="fas fa-print"></i> Form
                            </a>
                            @if (item.Status == "Menunggu Approval" && (!isStaffOrAdmin || item.PemohonUser == User.Identity?.Name))
                            {
                                <form asp-action="Cancel" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Yakin batalkan permintaan ini?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-dark btn-xs" title="Batalkan">
                                        <i class="fas fa-times"></i>
                                    </button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
